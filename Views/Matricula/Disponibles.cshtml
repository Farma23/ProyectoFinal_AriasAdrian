@model IEnumerable<ProyectoFinal_AriasAdrian.Models.Curso>
@{
    ViewData["Title"] = "Cursos Disponibles";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-journal-plus me-2 text-primary"></i>Cursos Disponibles Para Matricular</h2>
    <a asp-controller="Home" asp-action="PortalEstudiante" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Volver a Mi Portal
    </a>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small text-muted">Buscar por código o nombre</label>
                <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Ej. CI-101 o Programación" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted">Período</label>
                <select name="periodo" class="form-select">
                    <option value="">Todos</option>
                    @foreach (var p in (IEnumerable<string>)ViewBag.Periodos)
                    {
                        if (p == ViewBag.PeriodoSeleccionado)
                        {
                            <option value="@p" selected>@p</option>
                        }
                        else
                        {
                            <option value="@p">@p</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-funnel me-1"></i>Filtrar
                </button>
                <a asp-action="Disponibles" class="btn btn-outline-secondary">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<div id="alertaMatricula"></div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                No hay cursos disponibles con los filtros seleccionados.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Código</th>
                            <th>Curso</th>
                            <th>Docente</th>
                            <th>Créditos</th>
                            <th>Período</th>
                            <th>Cupos</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr id="fila-curso-@c.Id">
                                <td><span class="badge bg-primary">@c.Codigo</span></td>
                                <td>@c.Nombre</td>
                                <td class="text-muted">@(c.Docente?.NombreCompleto ?? "Por asignar")</td>
                                <td>@c.Creditos</td>
                                <td>@c.Periodo</td>
                                <td>
                                    <span class="badge @(c.CuposDisponibles > 0 ? "bg-success" : "bg-secondary")" id="cupos-@c.Id">
                                        @c.CuposDisponibles
                                    </span>
                                </td>
                                <td class="text-end">
                                    <button type="button"
                                            class="btn btn-sm btn-primary btn-matricular"
                                            data-curso-id="@c.Id"
                                            disabled="@(c.CuposDisponibles <= 0 ? "disabled" : null)">
                                        <i class="bi bi-plus-circle me-1"></i>Matricularme
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script src="~/js/matricula.js" asp-append-version="true"></script>
}
