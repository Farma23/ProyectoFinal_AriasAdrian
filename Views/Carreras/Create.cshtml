@model ProyectoFinal_AriasAdrian.Models.Carrera
@{ ViewData["Title"] = "Nueva Carrera"; }

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-primary text-white fw-semibold">
                <i class="bi bi-plus-circle me-2"></i>Nueva Carrera
            </div>
            <div class="card-body p-4">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>
                    <div class="mb-3">
                        <label asp-for="Codigo" class="form-label fw-semibold"></label>
                        <input asp-for="Codigo" class="form-control" placeholder="Ej: ING-SIS" />
                        <span asp-validation-for="Codigo" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label fw-semibold"></label>
                        <input asp-for="Nombre" class="form-control" placeholder="Nombre completo de la carrera" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label fw-semibold"></label>
                        <textarea asp-for="Descripcion" class="form-control" rows="2" placeholder="Descripción breve"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label asp-for="Semestres" class="form-label fw-semibold"></label>
                            <input asp-for="Semestres" class="form-control" type="number" min="1" max="12" />
                            <span asp-validation-for="Semestres" class="text-danger small"></span>
                        </div>
                        <div class="col-6 mb-3">
                            <label asp-for="CreditosTotales" class="form-label fw-semibold"></label>
                            <input asp-for="CreditosTotales" class="form-control" type="number" min="1" />
                            <span asp-validation-for="CreditosTotales" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Guardar</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
