@model IEnumerable<ProyectoFinal_AriasAdrian.Models.Estudiante>
@{ ViewData["Title"] = "Estudiantes"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-people me-2 text-info"></i>Gestión de Estudiantes</h2>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Nombre</th><th>Cédula</th><th>Correo</th>
                    <th>Carrera</th><th>Estado</th><th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td>@e.NombreCompleto</td>
                        <td class="text-muted small">@e.Cedula</td>
                        <td class="text-muted small">@e.Correo</td>
                        <td class="text-muted small">@e.Carrera?.Nombre</td>
                        <td><span class="badge @(e.Activo ? "bg-success" : "bg-secondary")">@(e.Activo ? "Activo" : "Inactivo")</span></td>
                        <td>
                            <a asp-action="Details" asp-route-id="@e.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@e.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
