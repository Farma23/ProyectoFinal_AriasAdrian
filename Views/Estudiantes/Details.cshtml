@model ProyectoFinal_AriasAdrian.Models.Estudiante
@{ ViewData["Title"] = "Detalle de Estudiante"; }

<div class="row justify-content-center"><div class="col-md-8">
<div class="card border-0 shadow-sm">
<div class="card-header bg-info text-white fw-semibold">
    <i class="bi bi-person me-2"></i>@Model.NombreCompleto
</div>
<div class="card-body p-4">
    <dl class="row">
        <dt class="col-4">Nombre</dt><dd class="col-8">@Model.NombreCompleto</dd>
        <dt class="col-4">Cédula</dt><dd class="col-8">@Model.Cedula</dd>
        <dt class="col-4">Correo</dt><dd class="col-8">@Model.Correo</dd>
        <dt class="col-4">Carrera</dt><dd class="col-8">@Model.Carrera?.Nombre</dd>
        <dt class="col-4">Fecha Ingreso</dt><dd class="col-8">@Model.FechaIngreso.ToString("dd/MM/yyyy")</dd>
        <dt class="col-4">Estado</dt>
        <dd class="col-8"><span class="badge @(Model.Activo ? "bg-success" : "bg-secondary")">@(Model.Activo ? "Activo" : "Inactivo")</span></dd>
    </dl>

    @if (Model.Matriculas.Any())
    {
        <h6 class="mt-3 fw-semibold">Matrículas</h6>
        <table class="table table-sm table-bordered">
            <thead class="table-light">
                <tr><th>Curso</th><th>Fecha</th><th>Estado</th></tr>
            </thead>
            <tbody>
                @foreach (var m in Model.Matriculas)
                {
                    <tr>
                        <td>@m.Curso?.Nombre</td>
                        <td>@m.FechaMatricula.ToString("dd/MM/yyyy")</td>
                        <td><span class="badge bg-success">@m.Estado</span></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
<div class="card-footer bg-transparent d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm"><i class="bi bi-pencil me-1"></i>Editar</a>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Volver</a>
</div>
</div></div></div>
