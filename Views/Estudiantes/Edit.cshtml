@model ProyectoFinal_AriasAdrian.Models.Estudiante
@{ ViewData["Title"] = "Editar Estudiante"; }

<div class="row justify-content-center"><div class="col-md-7">
<div class="card border-0 shadow-sm">
<div class="card-header bg-warning text-dark fw-semibold"><i class="bi bi-pencil me-2"></i>Editar Estudiante</div>
<div class="card-body p-4">
<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="UserId" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>
    <div class="mb-3"><label asp-for="NombreCompleto" class="form-label fw-semibold"></label>
    <input asp-for="NombreCompleto" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Cedula" class="form-label fw-semibold"></label>
    <input asp-for="Cedula" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Correo" class="form-label fw-semibold"></label>
    <input asp-for="Correo" class="form-control" /></div>
    <div class="mb-3"><label asp-for="CarreraId" class="form-label fw-semibold"></label>
    <select asp-for="CarreraId" asp-items="ViewBag.CarreraId" class="form-select"></select></div>
    <div class="mb-3"><label asp-for="FechaIngreso" class="form-label fw-semibold"></label>
    <input asp-for="FechaIngreso" class="form-control" type="date" /></div>
    <div class="mb-3 form-check"><input asp-for="Activo" class="form-check-input" />
    <label asp-for="Activo" class="form-check-label">Activo</label></div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Actualizar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>
</div></div></div></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
