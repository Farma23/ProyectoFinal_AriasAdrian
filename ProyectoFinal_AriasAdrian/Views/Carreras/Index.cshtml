@model IEnumerable<ProyectoFinal_AriasAdrian.Models.Carrera>
@{
    ViewData["Title"] = "Carreras";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-mortarboard me-2 text-primary"></i>Carreras Universitarias</h2>
    @if (User.IsInRole("Administrador"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>Nueva Carrera
        </a>
    }
</div>

<div class="row g-3">
    @foreach (var c in Model)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="badge bg-primary">@c.Codigo</span>
                        <small class="text-muted">@c.Semestres semestres · @c.CreditosTotales créditos</small>
                    </div>
                    <h5 class="card-title">@c.Nombre</h5>
                    <p class="card-text text-muted small">@c.Descripcion</p>
                </div>
                @if (User.IsInRole("Administrador"))
                {
                    <div class="card-footer bg-transparent d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-warning">
                            <i class="bi bi-pencil"></i> Editar
                        </a>
                        <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-info">
                            <i class="bi bi-eye"></i> Detalles
                        </a>
                        <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i> Eliminar
                        </a>
                    </div>
                }
            </div>
        </div>
    }
</div>
