@{
    ViewData["Title"] = "Panel de Administración";
}

<h2 class="mb-1"><i class="bi bi-speedometer2 me-2 text-primary"></i>Panel de Administración</h2>
<p class="text-muted mb-4">Resumen general del sistema — Período 2025-I</p>

<div class="row g-4 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                    <i class="bi bi-people-fill text-primary fs-3"></i>
                </div>
                <div>
                    <div class="fs-2 fw-bold">@ViewBag.TotalEstudiantes</div>
                    <div class="text-muted small">Estudiantes Activos</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="bg-success bg-opacity-10 rounded-3 p-3">
                    <i class="bi bi-book-fill text-success fs-3"></i>
                </div>
                <div>
                    <div class="fs-2 fw-bold">@ViewBag.TotalCursos</div>
                    <div class="text-muted small">Cursos Disponibles</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="bg-warning bg-opacity-10 rounded-3 p-3">
                    <i class="bi bi-person-video3 text-warning fs-3"></i>
                </div>
                <div>
                    <div class="fs-2 fw-bold">@ViewBag.TotalDocentes</div>
                    <div class="text-muted small">Docentes Registrados</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="bg-info bg-opacity-10 rounded-3 p-3">
                    <i class="bi bi-clipboard-check text-info fs-3"></i>
                </div>
                <div>
                    <div class="fs-2 fw-bold">@ViewBag.TotalMatriculas</div>
                    <div class="text-muted small">Matrículas Realizadas</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">Accesos Rápidos</div>
            <div class="card-body d-grid gap-2">
                <a asp-controller="Carreras" asp-action="Create" class="btn btn-outline-primary">
                    <i class="bi bi-plus-circle me-2"></i>Nueva Carrera
                </a>
                <a asp-controller="Cursos" asp-action="Create" class="btn btn-outline-success">
                    <i class="bi bi-plus-circle me-2"></i>Nuevo Curso
                </a>
                <a asp-controller="Docentes" asp-action="Create" class="btn btn-outline-warning">
                    <i class="bi bi-plus-circle me-2"></i>Nuevo Docente
                </a>
                <a asp-controller="Estudiantes" asp-action="Index" class="btn btn-outline-info">
                    <i class="bi bi-people me-2"></i>Ver Estudiantes
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">Gestión del Sistema</div>
            <div class="list-group list-group-flush">
                <a asp-controller="Carreras" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center gap-2">
                    <i class="bi bi-mortarboard text-primary"></i> Administrar Carreras
                </a>
                <a asp-controller="Cursos" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center gap-2">
                    <i class="bi bi-book text-success"></i> Administrar Cursos
                </a>
                <a asp-controller="Docentes" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center gap-2">
                    <i class="bi bi-person-video3 text-warning"></i> Administrar Docentes
                </a>
                <a asp-controller="Estudiantes" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center gap-2">
                    <i class="bi bi-people text-info"></i> Administrar Estudiantes
                </a>
            </div>
        </div>
    </div>
</div>
