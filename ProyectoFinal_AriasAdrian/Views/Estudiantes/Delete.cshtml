@model ProyectoFinal_AriasAdrian.Models.Estudiante
@{ ViewData["Title"] = "Eliminar Estudiante"; }
<div class="row justify-content-center"><div class="col-md-6">
<div class="card border-0 shadow-sm">
<div class="card-header bg-danger text-white fw-semibold"><i class="bi bi-trash me-2"></i>Eliminar Estudiante</div>
<div class="card-body p-4">
    <div class="alert alert-warning"><i class="bi bi-exclamation-triangle-fill me-2"></i>¿Está seguro que desea eliminar este estudiante?</div>
    <dl class="row">
        <dt class="col-4">Nombre</dt><dd class="col-8">@Model.NombreCompleto</dd>
        <dt class="col-4">Cédula</dt><dd class="col-8">@Model.Cedula</dd>
        <dt class="col-4">Carrera</dt><dd class="col-8">@Model.Carrera?.Nombre</dd>
    </dl>
    <form asp-action="Delete"><input type="hidden" asp-for="Id" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Eliminar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div></div></div></div>
