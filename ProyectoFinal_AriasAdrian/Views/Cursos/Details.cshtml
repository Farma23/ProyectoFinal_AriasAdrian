@model ProyectoFinal_AriasAdrian.Models.Curso
@{ ViewData["Title"] = "Detalle de Curso"; }
<div class="row justify-content-center"><div class="col-md-7">
<div class="card border-0 shadow-sm">
<div class="card-header bg-info text-white fw-semibold"><i class="bi bi-book me-2"></i>@Model.Nombre</div>
<div class="card-body p-4">
    <dl class="row">
        <dt class="col-4">Código</dt><dd class="col-8"><span class="badge bg-success">@Model.Codigo</span></dd>
        <dt class="col-4">Nombre</dt><dd class="col-8">@Model.Nombre</dd>
        <dt class="col-4">Carrera</dt><dd class="col-8">@Model.Carrera?.Nombre</dd>
        <dt class="col-4">Docente</dt><dd class="col-8">@(Model.Docente?.NombreCompleto ?? "Sin asignar")</dd>
        <dt class="col-4">Créditos</dt><dd class="col-8">@Model.Creditos</dd>
        <dt class="col-4">Cupos</dt><dd class="col-8">@Model.CuposDisponibles</dd>
        <dt class="col-4">Período</dt><dd class="col-8">@Model.Periodo</dd>
    </dl>
</div>
<div class="card-footer bg-transparent d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm"><i class="bi bi-pencil me-1"></i>Editar</a>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Volver</a>
</div>
</div></div></div>
