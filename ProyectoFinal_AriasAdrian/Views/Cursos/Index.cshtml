@model IEnumerable<ProyectoFinal_AriasAdrian.Models.Curso>
@{ ViewData["Title"] = "Cursos"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-book me-2 text-success"></i>Gestión de Cursos</h2>
    <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-circle me-1"></i>Nuevo Curso</a>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small text-muted">Buscar</label>
                <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Código o nombre" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted">Carrera</label>
                <select name="carreraId" class="form-select" asp-items="ViewBag.Carreras">
                    <option value="">Todas</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Período</label>
                <select name="periodo" class="form-select">
                    <option value="">Todos</option>
                    @foreach (var p in (IEnumerable<string>)ViewBag.Periodos)
                    {
                        if (p == (string?)ViewBag.Periodo)
                        {
                            <option value="@p" selected>@p</option>
                        }
                        else
                        {
                            <option value="@p">@p</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Créditos</label>
                <input type="number" name="creditos" value="@ViewBag.Creditos" class="form-control" min="1" max="10" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-funnel me-1"></i>Filtrar</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Código</th><th>Nombre</th><th>Carrera</th><th>Docente</th>
                    <th>Créditos</th><th>Período</th><th>Cupos</th><th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">No se encontraron cursos con los filtros seleccionados.</td>
                    </tr>
                }
                @foreach (var c in Model)
                {
                    <tr>
                        <td><span class="badge bg-success">@c.Codigo</span></td>
                        <td>@c.Nombre</td>
                        <td class="text-muted small">@c.Carrera?.Nombre</td>
                        <td class="text-muted small">@(c.Docente?.NombreCompleto ?? "Sin asignar")</td>
                        <td>@c.Creditos</td>
                        <td>@c.Periodo</td>
                        <td>@c.CuposDisponibles</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                            <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-body">
        <partial name="_Pagination" />
    </div>
</div>
