@model IEnumerable<ProyectoFinal_AriasAdrian.Models.Curso>
@{ ViewData["Title"] = "Cursos"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-book me-2 text-success"></i>Gestión de Cursos</h2>
    <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-circle me-1"></i>Nuevo Curso</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Código</th><th>Nombre</th><th>Carrera</th><th>Docente</th>
                    <th>Créditos</th><th>Cupos</th><th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td><span class="badge bg-success">@c.Codigo</span></td>
                        <td>@c.Nombre</td>
                        <td class="text-muted small">@c.Carrera?.Nombre</td>
                        <td class="text-muted small">@(c.Docente?.NombreCompleto ?? "Sin asignar")</td>
                        <td>@c.Creditos</td>
                        <td>@c.CuposDisponibles</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                            <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
