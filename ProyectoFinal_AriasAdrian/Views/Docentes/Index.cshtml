@model IEnumerable<ProyectoFinal_AriasAdrian.Models.Docente>
@{ ViewData["Title"] = "Docentes"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-person-video3 me-2 text-warning"></i>Gestión de Docentes</h2>
    <a asp-action="Create" class="btn btn-warning"><i class="bi bi-plus-circle me-1"></i>Nuevo Docente</a>
</div>
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr><th>Nombre</th><th>Correo</th><th>Especialidad</th><th>Estado</th><th>Cursos</th><th>Acciones</th></tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td>@d.NombreCompleto</td>
                        <td class="text-muted small">@d.Correo</td>
                        <td class="text-muted small">@d.Especialidad</td>
                        <td><span class="badge @(d.Activo ? "bg-success" : "bg-secondary")">@(d.Activo ? "Activo" : "Inactivo")</span></td>
                        <td>@d.Cursos.Count</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Details" asp-route-id="@d.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                            <a asp-action="Delete" asp-route-id="@d.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
