@model ProyectoFinal_AriasAdrian.Models.Docente
@{ ViewData["Title"] = "Nuevo Docente"; }
<div class="row justify-content-center"><div class="col-md-6">
<div class="card border-0 shadow-sm">
<div class="card-header bg-warning text-dark fw-semibold"><i class="bi bi-plus-circle me-2"></i>Nuevo Docente</div>
<div class="card-body p-4">
<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>
    <div class="mb-3"><label asp-for="NombreCompleto" class="form-label fw-semibold"></label>
    <input asp-for="NombreCompleto" class="form-control" /><span asp-validation-for="NombreCompleto" class="text-danger small"></span></div>
    <div class="mb-3"><label asp-for="Correo" class="form-label fw-semibold"></label>
    <input asp-for="Correo" class="form-control" /><span asp-validation-for="Correo" class="text-danger small"></span></div>
    <div class="mb-3"><label asp-for="Especialidad" class="form-label fw-semibold"></label>
    <input asp-for="Especialidad" class="form-control" /></div>
    <div class="mb-3 form-check"><input asp-for="Activo" class="form-check-input" /><label asp-for="Activo" class="form-check-label">Activo</label></div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Guardar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>
</div></div></div></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
