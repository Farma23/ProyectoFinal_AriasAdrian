@model ProyectoFinal_AriasAdrian.Models.Docente
@{ ViewData["Title"] = "Detalle de Docente"; }
<div class="row justify-content-center"><div class="col-md-7">
<div class="card border-0 shadow-sm">
<div class="card-header bg-info text-white fw-semibold"><i class="bi bi-person-video3 me-2"></i>@Model.NombreCompleto</div>
<div class="card-body p-4">
    <dl class="row">
        <dt class="col-4">Nombre</dt><dd class="col-8">@Model.NombreCompleto</dd>
        <dt class="col-4">Correo</dt><dd class="col-8">@Model.Correo</dd>
        <dt class="col-4">Especialidad</dt><dd class="col-8">@Model.Especialidad</dd>
        <dt class="col-4">Estado</dt><dd class="col-8"><span class="badge @(Model.Activo ? "bg-success" : "bg-secondary")">@(Model.Activo ? "Activo" : "Inactivo")</span></dd>
        <dt class="col-4">Cursos asignados</dt><dd class="col-8">@Model.Cursos.Count</dd>
    </dl>
</div>
<div class="card-footer bg-transparent d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm"><i class="bi bi-pencil me-1"></i>Editar</a>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Volver</a>
</div>
</div></div></div>
